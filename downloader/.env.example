# Supabase → Project Settings → API (la service_role es SECRETA: solo aquí, nunca en el frontend)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Dominio(s) del frontend, separados por coma (ej. https://alabanza.vercel.app)
ALLOWED_ORIGINS=*

# Opcional: capa extra. Si lo defines, pon el mismo valor en VITE_DOWNLOADER_TOKEN del frontend.
API_TOKEN=

# Opcional: cookies de YouTube (formato Netscape) si YouTube bloquea la IP del servidor.
# Usa UNA de las dos: la ruta a un Secret File o el contenido completo.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES=

MAX_DURATION_SEC=1200
MAX_CONCURRENT_JOBS=2
MP3_QUALITY=128
